{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npx eslint *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(npx eslint *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git restore *)",
      "Bash(rm *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm add *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "PowerShell(git push *)",
      "PowerShell(git restore *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(vercel *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(node_modules/**)",
      "Read(.next/**)",
      "Read(out/**)",
      "Read(package-lock.json)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *--delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * main*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .*)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(psql *)",
      "Bash(supabase *)",
      "Bash(npx supabase *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * main*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git branch -D *)",
      "PowerShell(psql *)",
      "PowerShell(supabase *)",
      "mcp__supabase"
    ]
  }
}
